<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_delivery_confirm_wizard_form" model="ir.ui.view">
        <field name="name">sale.delivery.confirm.wizard.form</field>
        <field name="model">sale.delivery.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Delivery Method">
                <div class="o_form_view_container">
                    <p>Do you want to add a delivery method?</p>
                </div>
                <footer>
                    <button name="action_add_delivery"
                            string="Add Delivery Method"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_confirm_without_delivery"
                            string="Confirm Without Delivery"
                            type="object"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
