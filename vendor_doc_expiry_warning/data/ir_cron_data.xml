<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Daily cron: detect vendors with W-9 or COI expiring within 30 days,
        set the pre-expiration flag, and schedule a follow-up activity.
        Starts inactive so admins can review schedule before enabling.
    -->
    <record id="ir_cron_vendor_doc_expiry_warning" model="ir.cron">
        <field name="name">Vendor Document Expiration Pre-Warning</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_vendor_doc_expiry_warning()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>

    <!--
        Weekly cron: send a consolidated expiring-document summary email
        to all active users in purchase.group_purchase_manager.
        Starts inactive so admins can review schedule before enabling.
    -->
    <record id="ir_cron_vendor_doc_weekly_summary" model="ir.cron">
        <field name="name">Vendor Document Expiration Weekly Summary</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_vendor_doc_weekly_summary()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">False</field>
    </record>
</odoo>
