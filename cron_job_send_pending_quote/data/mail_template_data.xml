<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Email template: Pending Quotations
        Model: sale.order
        Purpose: Reminder email sent to the salesperson (user_id) for a pending
                 (draft/sent) quotation. Used by the 'Daily Pending Quotations'
                 scheduled action via the consolidated cron method, and also
                 available in the UI for manual sends on individual quotations.
    -->
    <record id="email_template_pending_quotations" model="mail.template">
        <field name="name">Pending Quotations</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">Quotations at the end of each day</field>
        <field name="email_to">{{ object.user_id.email or '' }}</field>
        <field name="body_html" type="html">
            <p>Hi <t t-esc="object.user_id.name"/>,</p>
            <p>There are quotations that are in pending till today:</p>
            <ul>
                <li><t t-esc="object.name"/></li>
            </ul>
            <p>Please take a look at these!</p>
        </field>
    </record>
</odoo>
