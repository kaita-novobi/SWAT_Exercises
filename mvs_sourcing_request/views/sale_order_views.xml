<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_sourcing" model="ir.ui.view">
        <field name="name">sale.order.form.sourcing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_sourcing" type="object"
                        string="Request Sourcing"
                        groups="sales_team.group_sale_salesman"
                        invisible="state not in ('draft', 'sent', 'sale') or sourcing_request_count &gt; 0"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sourcing_requests" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="sourcing_request_count == 0">
                    <field name="sourcing_request_count" widget="statinfo"
                           string="Sourcing"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
