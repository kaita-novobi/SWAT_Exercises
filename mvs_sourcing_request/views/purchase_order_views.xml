<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_sourcing" model="ir.ui.view">
        <field name="name">purchase.order.form.sourcing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sourcing_request" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not sourcing_request_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sourcing</span>
                        <span class="o_stat_text">Request</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
